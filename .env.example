# The public origin this deploy answers on. Sets canonical URLs, sitemap.xml,
# robots.txt and every og:image. Without it those fall back to the production
# domain, which is right in production and wrong everywhere else — set it on
# preview and staging deploys.
NEXT_PUBLIC_SITE_URL=https://unhingedsocial.us

# Supabase — project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Stripe — card settlement of house-account balances (optional; the settle button hides when unset)
STRIPE_SECRET_KEY=sk_test_...
# Signing secret for /api/stripe/webhook (from `stripe listen` or the dashboard endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...
# Supabase service-role key — server-only; the webhook uses it to post ledger payments
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Aurora AI — LLM brain (optional; without it the assistant runs deterministic fallback)
ANTHROPIC_API_KEY=<sk-ant-...>

# Web push — the public half of the VAPID pair the send-push drain signs with
# (the private half lives in Supabase Vault as VAPID_PRIVATE_KEY).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public-key>

# ---- gates and scripts (never needed by the running app) ----
# npm run e2e / routes:audit / documents:snapshot sign in as the fixture personas
E2E_PASSWORD=<fixture-persona-password>
E2E_EMAIL=e2e-regional@fixtures.invalid
# the server under test
BASE_URL=http://localhost:3000
# scripts/register-sms-templates.mjs
SENT_API_KEY=<sent.dm-api-key>
STAFF_EMAIL=<staff-login>
STAFF_PASSWORD=<staff-password>

# ---- edge functions (Supabase function secrets, not Vercel) ----
# send-outbox: RESEND_API_KEY, OUTBOX_FROM, APP_URL — send-sms: SENT_API_KEY —
# send-push: VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT — all three: CRON_SECRET.
# Each is read from the function's env first and from Vault (get_app_secret) second.

# Wallet passes (docs/WALLET.md). All optional: without them the routes answer
# 501 in the club's voice and the card page shows no wallet buttons.
# APPLE_PASS_TYPE_ID=pass.us.unhingedsocial.member
# APPLE_TEAM_ID=
# APPLE_PASS_CERT_PEM=
# APPLE_PASS_KEY_PEM=
# APPLE_PASS_KEY_PASSPHRASE=
# APPLE_WWDR_PEM=
# APPLE_APNS_KEY_PEM=
# APPLE_APNS_KEY_ID=
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SA_EMAIL=
# GOOGLE_WALLET_SA_KEY_PEM=
